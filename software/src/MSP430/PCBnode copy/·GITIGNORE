# =============================================================
#  CCS / MSP430FR2355 Project — .gitignore
#  Keep source & config in git; exclude all build artifacts.
# =============================================================

# ---- Build output directories ----
Debug/
Release/

# ---- Compiled / linked output ----
*.out
*.map
*.hex
*.obj
*.asm
*_linkInfo.xml

# ---- CCS auto-generated files (do NOT commit these) ----
# .clangd is auto-regenerated by CCS on every build
.clangd

# targetConfigs is auto-generated from .ccsproject — no need to commit
targetConfigs/

# CCS stores absolute workspace paths here — breaks on other machines
.settings/

# ---- macOS junk ----
.DS_Store

# ---- Windows junk ----
Thumbs.db

# =============================================================
#  FILES THAT ARE COMMITTED (kept in git intentionally):
#    .ccsproject   — device & connection config (MSP430FR2355)
#    .cproject     — compiler/linker flags, include paths, defines
#    .project      — Eclipse project name & build natures
#    lnk_msp430fr2355.cmd — linker memory map
#    *.c / *.h     — all source files
# =============================================================